# See Curavite Hospital Management — Optional Environment Variables Template
# Note: For static Vercel/Firebase deployment, paste your Firebase Web Config
# directly into `public/js/firebase-config.js` as explained in SETUP_GUIDE.md.

FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# Optional SMS / WhatsApp Gateway Webhook (if integrating Fast2SMS / Twilio / Cloud Function)
SMS_GATEWAY_WEBHOOK_URL=
